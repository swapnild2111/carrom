---
// Header nav — same shape as Hugo's baseof.html header. Seasons are baked
// into the page at build time (via fetchHomeSnapshot) so the picker renders
// synchronously — no client Firestore fetch, no disappear/reappear flash.
import SeasonPicker from "./SeasonPicker.svelte";
import { fetchHomeSnapshot } from "../../lib/firestore-server";
const snapshot = await fetchHomeSnapshot();
const seasons = snapshot.seasons.filter((s) => s.available !== false);
---
<header class="site-header">
  <div class="container header-inner">
    <div class="header-brand">
      <a class="site-logo" href="/" aria-label="Thane Carrom Slams home">
        <img src="/images/carrom-logo.svg" width="52" height="52" alt="" />
      </a>
      <div class="header-titles">
        <h1 class="site-title"><a href="/">Thane Carrom Slams</a></h1>
        <p class="site-tagline">
          <span data-season-label>—</span> season · Thane District
          <span data-season-stats>— · —</span>
        </p>
      </div>
    </div>
    <nav class="header-nav" aria-label="Main">
      <SeasonPicker client:load seasons={seasons} />
      <a href="/" class="nav-link" data-season-link>Leaderboard</a>
      <a href="/clubs/" class="nav-link" data-season-link>Clubs</a>
      <a href="/awards/" class="nav-link" data-season-link data-season-awards>Awards</a>
      <a href="/admin/" class="nav-link nav-link-muted" data-season-link>Admin</a>
    </nav>
  </div>
</header>
