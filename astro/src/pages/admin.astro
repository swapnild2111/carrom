---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdminGate from "../components/auth/AdminGate.svelte";
import AdminApp from "../components/admin/AdminApp.svelte";
---
<BaseLayout title="Admin · Thane Carrom Slams">
  <div class="admin-shell">
    <AdminGate client:load>
      <AdminApp client:load />
    </AdminGate>
  </div>
</BaseLayout>

<style>
  /* Not a .page-section — that class adds a 2.5rem top margin meant for
     narrative pages. Admin should sit right below the site header. */
  .admin-shell {
    padding: 0.85rem 0 2rem;
  }
</style>
