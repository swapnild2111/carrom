---
// Site-wide shell. Ports layouts/_default/baseof.html — same nav structure,
// same season picker, same footer. Everything data-driven now hydrates from
// Firestore inside islands.
//
// <ClientRouter /> enables Astro View Transitions: internal link clicks and
// season-picker navigations become soft transitions with no white flash.
// The URL still updates and pages stay statically pre-rendered.
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Thane Carrom Slams",
  description = "Live leaderboard, player profiles, club records, and season awards for Thane District carrom.",
} = Astro.props;

const copyrightEnd = new Date().getFullYear();
const copyrightStart = 2025;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/images/carrom-logo.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <ClientRouter />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <SiteHeader />

  <main class="container" id="main-content">
    <slot />
  </main>

  <SiteFooter copyrightStart={copyrightStart} copyrightEnd={copyrightEnd} />
</body>
</html>
