rules_version = '2';

// Carrom Thane — Firestore security rules
//
// Model:
//   - Anyone can read all data collections (public site is public).
//   - Writes require the caller's UID to exist in /admins/{uid}.
//   - Every write must stamp updatedBy=auth.uid, updatedAt=serverTimestamp.
//   - Hard-delete is forbidden; use active=false soft-delete instead.
//   - /admins itself is writable only by users with role="owner".
//   - /audit_log is append-only for admins, readable by admins.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "owner";
    }

    // Every admin write must stamp itself with the caller's uid + a server timestamp.
    function stampsUpdater() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // On create, createdBy/createdAt must ALSO be the caller (not spoofed).
    function stampsCreator() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && stampsUpdater();
    }

    // ── Data collections ────────────────────────────────────────────
    match /players/{playerId} {
      allow read: if true;
      allow create: if isAdmin() && stampsCreator();
      allow update: if isAdmin() && stampsUpdater();
      allow delete: if false;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAdmin() && stampsCreator();
      allow update: if isAdmin() && stampsUpdater();
      allow delete: if false;
    }

    match /slams/{slamId} {
      allow read: if true;
      allow create: if isAdmin() && stampsCreator();
      allow update: if isAdmin() && stampsUpdater();
      allow delete: if false;
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow create: if isAdmin() && stampsCreator();
      allow update: if isAdmin() && stampsUpdater();
      allow delete: if false;
    }

    // ── Admin roster ────────────────────────────────────────────────
    // Owners can add/edit/remove admins. Existing admins can read the list.
    // A signed-in user can also CREATE their own /admins/{uid} doc IF a
    // matching /pending_admins_by_email/{email} record exists — this powers
    // the auto-promote-on-first-sign-in flow. The created doc must match
    // the pending record's role and be stamped with the caller's uid/email.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow create: if isOwner()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/pending_admins_by_email/$(request.auth.token.email.lower()))
          && request.resource.data.role == get(/databases/$(database)/documents/pending_admins_by_email/$(request.auth.token.email.lower())).data.role
          && request.resource.data.email == request.auth.token.email
        );
      allow update, delete: if isOwner();
    }

    // ── Pending admins (by email) ───────────────────────────────────
    // Owners maintain this list; the auto-promote flow reads/deletes the
    // caller's own record on first sign-in. Not public.
    match /pending_admins_by_email/{emailKey} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.token.email.lower() == emailKey);
      allow create, update: if isOwner();
      allow delete: if isOwner()
        || (isSignedIn() && request.auth.token.email.lower() == emailKey);
    }

    // ── System state ────────────────────────────────────────────────
    // /system/publish_status coordinates the auto-rebuild cron. Any admin
    // can mark it dirty after a successful write; the cron running under a
    // service-account bypasses these rules and manages `lastPublishedAt`.
    // Public visitors don't need to see this at all.
    match /system/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── Audit log ───────────────────────────────────────────────────
    // Append-only. Admins can read. Nothing can update or delete.
    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
