# Astro reads Firestore at build time via the Firebase Admin SDK.
# Copy this to `.env` and adjust for your machine.
#
# Point to a service-account JSON key downloaded from:
#   Firebase Console → Project settings → Service accounts → Generate new private key
# Keep the JSON file OUTSIDE the repo. `.gitignore` blocks *firebase-adminsdk*.json
# and serviceAccountKey*.json as a safety net.
GOOGLE_APPLICATION_CREDENTIALS=/Users/YOU/.config/carrom-thane-admin.json
